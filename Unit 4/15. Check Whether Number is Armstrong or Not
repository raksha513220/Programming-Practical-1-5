#include <stdio.h>
int main() {
    int num, temp, rem, digits = 0;
    long long sum = 0;
    printf("Enter a number: ");
    scanf("%d", &num);
    if (num < 0) {
        printf("%d is not an Armstrong number\n", num);
        return 0;
    }
    temp = num;
    while (temp > 0) {
        digits++;
        temp /= 10;
    }
    temp = num;
    while (temp > 0) {
        rem = temp % 10;
        long long p = 1;
        for (int i = 1; i <= digits; i++) {
            p *= rem;
        }
        sum += p;
        temp /= 10;
    }

    if (sum == num) {
        printf("%d is an Armstrong number\n", num);
    } else {
        printf("%d is not an Armstrong number\n", num);
    }
    return 0;
}

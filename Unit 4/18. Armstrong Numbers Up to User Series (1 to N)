#include <stdio.h>

int main() {
    int n;
    printf("Enter upper limit (N): ");
    scanf("%d", &n);

    printf("Armstrong numbers up to %d:\n", n);
    for (int num = 1; num <= n; num++) {
        int temp = num, digits = 0, rem;
        long long sum = 0;

        while (temp > 0) {
            digits++;
            temp /= 10;
        }

        temp = num;
        while (temp > 0) {
            rem = temp % 10;
            long long p = 1;
            for (int i = 1; i <= digits; i++) {
                p *= rem;
            }
            sum += p;
            temp /= 10;
        }

        if (sum == num) {
            printf("%d ", num);
        }
    }
    printf("\n");
    return 0;
}

#include <stdio.h>

int main() {
    int n, val = 1;
    printf("Enter number of rows (N): ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        if (i == 4) {
            printf("14 15");
        } else {
            for (int j = 1; j <= i; j++) {
                printf("%d ", val++);
            }
        }
        printf("\n");
    }
    return 0;
}

#include <stdio.h>

int main() {
    int n;
    printf("Enter number of rows (N): ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        if (i <= 3) {
            for (int j = 1; j <= i; j++) {
                printf("%d ", i);
            }
        } else if (i == 4) {
            for (int j = 1; j <= i; j++) {
                printf("%d ", j % 2 == 1 ? 1 : 0);
            }
        } else {
            for (int j = 1; j <= i; j++) {
                printf("1 ");
            }
        }
        printf("\n");
    }
    return 0;
}

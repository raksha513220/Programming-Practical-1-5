#include <stdio.h>

int main() {
    int n;
    printf("Enter number of rows (N): ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        if (i == 1) {
            printf("1");
        } else if (i == 2) {
            printf("1 0");
        } else if (i == 3) {
            printf("1 2 3");
        } else {
            for (int j = 1; j <= i; j++) {
                printf("%d ", i);
            }
        }
        printf("\n");
    }
    return 0;
}

#include <stdio.h>

int main() {
    int n, current = 7;
    printf("Enter number of rows (N): ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        if (i == 1) {
            printf("1 2 3 4 5");
        } else if (i == 2) {
            printf("1 2 3 4");
        } else if (i == 3) {
            printf("3 4 5");
        } else {
            int count = (i == 4) ? 4 : (i == 5 ? 3 : 2);
            for (int j = 1; j <= count; j++) {
                printf("%d ", current++);
            }
        }
        printf("\n");
    }
    return 0;
}

#include <stdio.h>
#include <math.h>

int isArmstrong(int n) {
    int original = n, digits = 0, sum = 0, temp = n;
    
    while (temp != 0) {
        digits++;
        temp /= 10;
    }
    
    temp = n;
    while (temp != 0) {
        int rem = temp % 10;
        sum += round(pow(rem, digits));
        temp /= 10;
    }
    return (original == sum);
}

int main() {
    int num;
    printf("Enter a number: ");
    scanf("%d", &num);
    if (isArmstrong(num))
        printf("%d is an Armstrong number.\n", num);
    else
        printf("%d is not an Armstrong number.\n", num);
    return 0;
}

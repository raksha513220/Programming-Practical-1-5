#include <stdio.h>

int reverseNumber(int num) {
    int rev = 0, rem;
    while (num != 0) {
        rem = num % 10;
        rev = rev * 10 + rem;
        num /= 10;
    }
    return rev;
}

int main() {
    int num;
    printf("Enter a number: ");
    scanf("%d", &num);

    printf("Reverse of %d = %d\n", num, reverseNumber(num));
    return 0;
}
